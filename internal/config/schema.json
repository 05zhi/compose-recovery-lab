{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://compose-recovery-lab.invalid/drill-v1.json",
  "title": "Compose Recovery Lab drill v1 (document-app-v1)",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "name", "template", "backup", "runtime", "checks", "report"],
  "properties": {
    "schema_version": {"const": 1},
    "name": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$"},
    "template": {"const": "document-app-v1"},
    "backup": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "path", "mapping"],
      "properties": {
        "type": {"const": "local_bundle"},
        "path": {"$ref": "#/$defs/path"},
        "mapping": {
          "type": "object", "additionalProperties": false,
          "required": ["database", "uploads", "app_config"],
          "properties": {
            "database": {"const": "database.dump"},
            "uploads": {"const": "uploads.tar"},
            "app_config": {"const": "app-config.sanitized.json"}
          }
        }
      }
    },
    "runtime": {
      "type": "object", "additionalProperties": false,
      "required": ["images_file", "work_dir", "timeout"],
      "properties": {
        "images_file": {"$ref": "#/$defs/path"},
        "work_dir": {"$ref": "#/$defs/path"},
        "timeout": {"type": "string", "pattern": "^[1-9][0-9]*(s|m|h)$"}
      }
    },
    "checks": {
      "type": "array", "minItems": 4, "maxItems": 4, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "required"],
        "properties": {
          "id": {"enum": ["sql-documents", "database-files", "login-search-download", "external-connectivity"]},
          "required": {"const": true}
        }
      }
    },
    "report": {
      "type": "object", "additionalProperties": false, "required": ["formats"],
      "properties": {"formats": {"type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true, "items": {"enum": ["json", "html"]}}}
    }
  },
  "$defs": {"path": {"type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^[^$~\u0000-\u001f]+$"}}
}
